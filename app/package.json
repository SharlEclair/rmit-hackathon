{
  "name": "assignment-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "tsx --env-file-if-exists=.env src/lib/db/migrate.ts --check && next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/check-c8.mjs && node scripts/check-design.mjs",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "db:migrate": "tsx --env-file-if-exists=.env src/lib/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "demo:smoke": "tsx --env-file-if-exists=.env scripts/smoke.ts",
    "demo:reset": "tsx --env-file-if-exists=.env src/lib/db/migrate.ts && tsx --env-file-if-exists=.env scripts/seed.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "drizzle-orm": "0.45.3",
    "next": "16.3.8",
    "pdfjs-dist": "6.3.289",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@babel/eslint-parser": "7.29.9",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.3.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
