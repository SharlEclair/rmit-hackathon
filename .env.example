# Assignment Assistant — environment template
# Copy to `.env` and fill in. NEVER commit `.env` (it is gitignored).
# Never paste real values into this file, into docs, or into a commit message.

# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────
# Postgres connection string. Any Postgres works (local, Supabase, Neon).
DATABASE_URL="postgresql://user:password@localhost:5432/assignment_assistant"

# ─────────────────────────────────────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────────────────────────────────────
# Session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-32-bytes-of-randomness"

# ─────────────────────────────────────────────────────────────────────────────
# Anonymous discussion identity
# ─────────────────────────────────────────────────────────────────────────────
# HMAC key for per-assignment pseudonyms ("Anonymous Student #482").
# Distinct from AUTH_SECRET so rotating one does not break the other.
# The (student, assignment) -> pseudonym mapping is persisted, so a student's
# label is STABLE within an assignment even across sessions. Rotating this key
# does not relabel existing posts; it only changes pseudonyms derived for
# assignments that have no stored identity yet. Changing it mid-assignment
# therefore creates an inconsistent set of labels -- treat it as permanent for
# the life of an assignment.
ANON_ID_SECRET="replace-me-with-32-bytes-of-randomness"

# ─────────────────────────────────────────────────────────────────────────────
# LLM provider — selected at runtime, never hard-coded in application code
# See docs/04-TECH-ARCHITECTURE.md § "Provider adapter"
# ─────────────────────────────────────────────────────────────────────────────
# Which adapter to use: deepseek | gemini | mock
# `mock` is a fully offline deterministic provider for tests and UI work, and it
# keeps the entire product loop walkable with no API key at all.
LLM_PROVIDER="mock"

# Default model for every AI capability. Verified against the live DeepSeek API
# docs: `deepseek-flash` (DeepSeek-V4.1-Flash) offers a 1M context window, JSON
# output, tool calls, AND vision — so one model covers ingestion, guardrail
# classification, assistant responses, moderation, and image-bearing student
# uploads. Do not invent model ids; an unknown id is an HTTP 400 at runtime.
LLM_MODEL_REASONING="deepseek-flash"

# Optional separate model for image and PDF attachments in student uploads.
# Leave empty to reuse LLM_MODEL_REASONING (correct for deepseek-flash, which
# handles vision natively). Audio and video are NOT resolved here and never
# reach a model: they are refused at the picker (O11, rule UP5).
LLM_MODEL_MULTIMODAL=""

# Credentials — set only the one matching LLM_PROVIDER.
DEEPSEEK_API_KEY=""
GEMINI_API_KEY=""

# Optional: override the provider base URL (proxies, self-hosted gateways).
LLM_BASE_URL=""

# Hard ceiling on model calls per assistant session. A runaway retry loop must
# fail loudly rather than silently burn the hackathon budget.
LLM_MAX_CALLS_PER_SESSION="12"

# ─────────────────────────────────────────────────────────────────────────────
# Object storage (uploaded assignment documents, student uploads)
# ─────────────────────────────────────────────────────────────────────────────
# Local filesystem driver for development. Set to `s3` to use a bucket.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./.storage"

# Only required when STORAGE_DRIVER=s3
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Maximum accepted upload size in bytes (default 25 MiB).
UPLOAD_MAX_BYTES="26214400"

# ─────────────────────────────────────────────────────────────────────────────
# Canvas (retired read-only discussion research — archive/canvas-scraper/)
# NOT required and NOT used by the app. The app must work with these unset:
# Canvas is a Tier 3 integration, out of MVP scope (D45). See docs/02-SCOPE.md.
# These exist only for the archived scraper, which is never imported by app/.
# ─────────────────────────────────────────────────────────────────────────────
CANVAS_BASE_URL="https://rmit.instructure.com"
CANVAS_TOKEN=""
CANVAS_COOKIE_FILE=""

# ─────────────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV="development"
# Public base URL, used for absolute links in emails/exports.
APP_BASE_URL="http://localhost:3000"
