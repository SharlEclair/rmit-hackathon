# Assignment Assistant -- environment template
# Copy to `.env` and fill in. NEVER commit `.env` (it is gitignored).
# Never paste real values into this file, into docs, or into a commit message.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Postgres connection string. Any Postgres works (local, Supabase, Neon).
DATABASE_URL="postgresql://user:password@localhost:5432/assignment_assistant"

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
# Session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-32-bytes-of-randomness"

# -----------------------------------------------------------------------------
# Anonymous discussion identity
# -----------------------------------------------------------------------------
# HMAC key for per-assignment pseudonyms ("Anonymous Student #482").
# Distinct from AUTH_SECRET so rotating one does not break the other.
# The (student, assignment) -> pseudonym mapping is persisted, so a student's
# label is STABLE within an assignment even across sessions. Rotating this key
# does not relabel existing posts; it only changes pseudonyms derived for
# assignments that have no stored identity yet. Changing it mid-assignment
# therefore creates an inconsistent set of labels -- treat it as permanent for
# the life of an assignment.
ANON_ID_SECRET="replace-me-with-32-bytes-of-randomness"

# -----------------------------------------------------------------------------
# LLM provider -- selected at runtime, never hard-coded in application code
# See docs/04-TECH-ARCHITECTURE.md S5 "The provider adapter"
# -----------------------------------------------------------------------------
# Which adapter to use: gemini | deepseek | mock
#  gemini  = the project default provider (D61)
#  deepseek = alternative adapter, kept working but not the default
#  mock  = fully offline deterministic provider for tests and UI work; keeps
#  the entire product loop walkable with no API key at all
LLM_PROVIDER="gemini"

# Default model for every AI capability.
# Verified against the live Gemini API docs: `gemini-3.8-flash` accepts TEXT,
# IMAGE, VIDEO, AUDIO and PDF input with a 1,048,576-token input limit and
# 65,536-token output, and supports structured outputs, context caching and
# thinking levels low/medium/high ("minimal" is NOT supported by this model and
# returns an error). One model therefore covers all five capabilities:
# assignment_analyst, policy_guard, student_assistant, discussion_moderator and
# insight_engine, including image- and PDF-bearing student uploads.
# Do not invent model ids; an unknown id fails at runtime.
LLM_MODEL_REASONING="gemini-3.8-flash"

# Optional separate model for image and PDF attachments in student uploads.
# Leave empty to reuse LLM_MODEL_REASONING, which is correct here because
# gemini-3.8-flash is natively multimodal. Audio and video are NOT resolved here
# and never reach a model: they are refused at the picker (O11, rule UP5).
LLM_MODEL_MULTIMODAL=""

# Thinking level per capability (gemini-3.8-flash: low | medium | high).
# Thinking is billed and adds latency, so it is set per capability rather than
# globally. The guardrail runs on every student turn and therefore gets the
# lowest setting; ingestion runs once per document and gets the highest.
# There is no insight-engine level: analytics refreshes make no model calls at
# all (D67) and are fully deterministic.
LLM_THINKING_GUARDRAIL="low"
LLM_THINKING_ASSISTANT="medium"
LLM_THINKING_ANALYST="high"
LLM_THINKING_MODERATOR="low"

# Credentials -- set only the one matching LLM_PROVIDER.
GEMINI_API_KEY=""
DEEPSEEK_API_KEY=""

# Optional: override the provider base URL (proxies, self-hosted gateways).
LLM_BASE_URL=""

# Hard ceiling on model calls per assistant session. A runaway retry loop must
# fail loudly rather than silently burn the hackathon budget.
LLM_MAX_CALLS_PER_SESSION="12"

# -----------------------------------------------------------------------------
# Object storage (uploaded assignment documents, student uploads)
# -----------------------------------------------------------------------------
# Local filesystem driver for development. Set to `s3` to use a bucket.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./.storage"

# Only required when STORAGE_DRIVER=s3
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Maximum accepted upload size in bytes (default 25 MiB).
UPLOAD_MAX_BYTES="26214400"

# -----------------------------------------------------------------------------
# Canvas (retired read-only discussion research -- archive/canvas-scraper/)
# NOT required and NOT used by the app. The app must work with these unset:
# Canvas/LMS integration is EXCLUDED by decision, not deferred (D45, D59) --
# there is no roadmap item and nothing may be stubbed. See docs/02-SCOPE.md.
# These exist only for the archived scraper, which is never imported by app/.
# -----------------------------------------------------------------------------
CANVAS_BASE_URL="https://rmit.instructure.com"
CANVAS_TOKEN=""
CANVAS_COOKIE_FILE=""

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV="development"
# Public base URL, used for absolute links in emails/exports.
APP_BASE_URL="http://localhost:3000"
